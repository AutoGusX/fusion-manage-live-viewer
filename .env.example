# Copy to ~/.fusion-manage-live-viewer/.env (or run `fmv setup`, which writes it for you).
# Never commit a filled-in copy.

# Required
APS_CLIENT_ID=            # Your APS app (type: Desktop, Mobile, Single-Page App)
FM_TENANT=                # e.g. mycompany for mycompany.autodeskplm360.net

# Optional
# FM_BASE_URL=https://mycompany.autodeskplm360.net
# FMV_PORT=4710
# APS_CALLBACK_URL=http://localhost:4710/callback   # must match your APS app exactly
# APS_SCOPES=data:read
# FMV_PERSIST_SESSION=true
# FMV_ALLOW_TOKEN_EXPORT=false
